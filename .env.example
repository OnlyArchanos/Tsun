DISCORD_TOKEN=your_discord_bot_token_here
MONGO_URI=your_mongodb_connection_string_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
DASHBOARD_PASSWORD=your_dashboard_password
SESSION_SECRET=your_session_secret_string

# Application configuration (Optional if defaults in config.js work for you)
# Comma-separated for multiple owners: OWNER_ID=id1,id2
OWNER_ID=your_discord_user_id
MAL_CLIENT_ID=your_myanimelist_client_id

# Conversational Tsun (disabled by default)
MISTRAL_API_KEY=your_mistral_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
TSUN_AI_ENABLED=false
TSUN_AI_GUILD_IDS=your_discord_guild_id
TSUN_AI_CHANNEL_IDS=your_discord_channel_id
TSUN_AI_MISTRAL_MODELS=ministral-14b-2512,ministral-8b-2512
TSUN_AI_OPENROUTER_MODELS=stealth/space-bunny-alpha,nvidia/nemotron-3-ultra-550b-a55b:free

# Optional operational tuning
# TSUN_AI_MAX_INPUT_CHARS=1500
# TSUN_AI_MAX_OUTPUT_TOKENS=300
# TSUN_AI_REQUEST_TIMEOUT_MS=12000
# TSUN_AI_TOTAL_DEADLINE_MS=45000
# TSUN_AI_USER_COOLDOWN_MS=3000
# TSUN_AI_SESSION_TTL_MS=1800000
# TSUN_AI_SESSION_MAX_MESSAGES=12
# TSUN_AI_MAX_SESSIONS=5000
# TSUN_AI_MAX_CONCURRENCY=3
# TSUN_AI_MAX_QUEUE_SIZE=20
# TSUN_AI_MAX_QUEUE_WAIT_MS=30000
# TSUN_AI_MAX_PROVIDER_STARTS_PER_MINUTE=18
# TSUN_AI_MIN_PROVIDER_START_INTERVAL_MS=1100
# TSUN_AI_MISTRAL_MIN_START_INTERVAL_MS=2100
# TSUN_AI_FALLBACK_QUOTA_RESERVE=5
